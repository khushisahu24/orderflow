# Copy to .env and point ORDERFLOW_DATABASE_URL at your PostgreSQL database.
# These values are for a local learning database. Do not reuse them anywhere else.

ORDERFLOW_DATABASE_URL=postgresql+psycopg://orderflow:orderflow@localhost:5432/orderflow
ORDERFLOW_JWT_SECRET=local-dev-secret-change-before-any-real-use
ORDERFLOW_ADMIN_PASSWORD=local-admin-change-me
ORDERFLOW_STAFF_PASSWORD=local-staff-change-me
ORDERFLOW_BCRYPT_ROUNDS=12
ORDERFLOW_LOG_LEVEL=INFO

# Used only by Pytest. Keep this separate from ORDERFLOW_DATABASE_URL.
ORDERFLOW_TEST_DATABASE_URL=postgresql+psycopg://orderflow:orderflow@localhost:5432/orderflow_test
